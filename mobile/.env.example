# EXPO_PUBLIC_-prefixed vars are inlined into the app bundle at build/start
# time (Expo SDK 49+ convention — same idea as web's NEXT_PUBLIC_API_URL).
#
# "localhost" only reaches the backend if you're running in a simulator on
# the same machine as the backend. Testing on a physical device via Expo Go
# needs your computer's LAN IP instead, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
