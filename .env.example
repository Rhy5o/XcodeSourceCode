# Used by `docker-compose up` to configure the whole stack (postgres, redis,
# backend, frontend) in one place. Copy to `.env` and fill in real secrets
# before deploying anywhere beyond local testing — every value below has a
# development-only default baked into docker-compose.yml, so `.env` itself
# is optional for a purely local `docker-compose up`.
#
# Running the backend or frontend outside Docker instead? Use
# backend/.env.example and frontend/.env.local.example directly.

# --- PostgreSQL ---
POSTGRES_USER=carracing
POSTGRES_PASSWORD=carracing_dev_pw
POSTGRES_DB=carracing_dev

# --- Backend (see backend/.env.example for what each of these does) ---
NODE_ENV=production
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:3000
MATCH_INTERVAL_MINUTES=5
ADMIN_SECRET=change_me
LEADERBOARD_CACHE_TTL_SECONDS=30
USER_PROFILE_CACHE_TTL_SECONDS=300
CLAN_STATS_CACHE_TTL_SECONDS=300
FOLLOWER_LIST_CACHE_TTL_SECONDS=600
GO_ONLINE_RATE_LIMIT_SECONDS=5
HEALTH_CHECK_INTERVAL_MINUTES=1
EXTERNAL_LOG_WEBHOOK_URL=

# --- Frontend ---
# Must be reachable from the *browser*, not just from inside the Docker
# network — localhost:3001 only works if the backend port is published to
# the host (docker-compose.yml does this by default for local testing).
NEXT_PUBLIC_API_URL=http://localhost:3001
