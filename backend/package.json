{
  "name": "car-racing-backend",
  "version": "1.0.0",
  "description": "API server for the car racing social media app",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node db/migrate.js",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "loadtest": "artillery run loadtest/artillery.yml",
    "loadtest:race": "node loadtest/runRaceCycleCheck.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "artillery": "^2.0.34",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.4"
  }
}
