PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://carracing:carracing_dev_pw@localhost:5432/carracing_dev
PGHOST=localhost
PGPORT=5432
PGUSER=carracing
PGPASSWORD=carracing_dev_pw
PGDATABASE=carracing_dev

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Match engine
MATCH_INTERVAL_MINUTES=5

# Admin (manual season reset, /api/admin/stats) — required header: X-Admin-Secret
ADMIN_SECRET=change_me

# Redis cache (Stage 8) — falls back to "always hit the DB" if unreachable
REDIS_URL=redis://localhost:6379
LEADERBOARD_CACHE_TTL_SECONDS=30
USER_PROFILE_CACHE_TTL_SECONDS=300
CLAN_STATS_CACHE_TTL_SECONDS=300
FOLLOWER_LIST_CACHE_TTL_SECONDS=600

# Anti-cheat (Stage 8)
GO_ONLINE_RATE_LIMIT_SECONDS=5

# Health check job (Stage 8)
HEALTH_CHECK_INTERVAL_MINUTES=1

# Optional: forward monitoring/logger.js entries (race cycles, suspicious
# activity, errors) to an external HTTPS ingestion endpoint (e.g. a Sentry
# envelope endpoint). Leave unset to only log to backend/logs/*.log.
EXTERNAL_LOG_WEBHOOK_URL=
