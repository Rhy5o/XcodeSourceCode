PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://carracing:carracing_dev_pw@localhost:5432/carracing_dev
PGHOST=localhost
PGPORT=5432
PGUSER=carracing
PGPASSWORD=carracing_dev_pw
PGDATABASE=carracing_dev

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Match engine
MATCH_INTERVAL_MINUTES=5

# Admin (manual season reset etc.) — required header: X-Admin-Secret
ADMIN_SECRET=change_me
